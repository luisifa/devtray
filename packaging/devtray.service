# 打包用（deb/rpm）的 systemd user unit —— 二进制在 /usr/bin。
# 本机 `cargo install` 的场景请用仓库根目录的 devtray.service（ExecStart=%h/.cargo/bin/devtray）。
[Unit]
Description=devtray —— 托盘常驻的开发服务管理器（tmux 托管）
Documentation=file:/usr/share/doc/devtray/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# systemd 的默认 PATH 里没有 ~/.bun/bin 这类用户目录，而 tmux 会话继承这里的环境 ——
# 不写这行，`bun run dev` 会 exit 127。
Environment=PATH=%h/.bun/bin:%h/.cargo/bin:%h/.local/bin:%h/.local/share/pnpm/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/lib/jvm/default/bin:/usr/lib/rustup/bin
ExecStart=/usr/bin/devtray
# 默认 control-group 会在 restart 时连带杀掉 tmux server（你所有 dev server），
# 所以必须 process。
KillMode=process
# 「退出」菜单项是 exit 0，用 always 会被立刻拉起来；只有崩溃才自动重启。
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/.local/state/devtray/service.log
StandardError=append:%h/.local/state/devtray/service.log

[Install]
WantedBy=default.target
